{
  "defaultMode": "acceptEdits",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(pip install*)",
      "Bash(uv pip install*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(aws *)",
      "Bash(gcloud *)"
    ],
    "allow": [
      "Bash(ls*)",
      "Bash(find .*)",
      "Bash(tree*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(make *)",
      "Bash(just *)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(uv run pytest*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(pnpm install*)",
      "Bash(pnpm run *)",
      "Bash(npm run *)",
      "Bash(prettier *)",
      "Bash(eslint *)",
      "Bash(ruff *)",
      "Bash(black *)"
    ]
  }
}
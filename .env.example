# Database
DATABASE_URL=sqlite:///./oad.db

# CORS
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Scraping
SCRAPE_RATE_LIMIT_SECONDS=2
SCRAPER_USER_AGENT=OneADay/1.0 (+https://yoursite.com/bot-info)

# LLM providers
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# Optional legacy provider
# OPENAI_API_KEY=

# Optional: search provider keys
# SEARCH_PROVIDER=
# SEARCH_API_KEY=

# Calendar (read-only)
# GCAL_CLIENT_ID=
# GCAL_CLIENT_SECRET=
# GCAL_REFRESH_TOKEN=

# Optional — error tracking (production)
# SENTRY_DSN=
